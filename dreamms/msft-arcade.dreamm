desc[msft-arcade]:

name = Microsoft Arcade
icon = msft-arcade.png
machine = pc
rootpath = C:\ARCADE
osenv= windows 3.11.002

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)

//
// warnings
//
INCOMPATIBLE = true
warning[incompatible]:
    condition = $(INCOMPATIBLE)
    text = The games in this pack have issues in tested DREAMM version (4.0x67)
end

//
//  Asteroids
//
game[pc-en-asteroids]:
    name = Asteroids
    anchorfile = ASTEROID.EXE
    launch = "$(rootpath)\ASTEROID.EXE"
    winres = 640x480x8
    file[]: crc = 9eb10d84; size =      6512; name = AMDSPIN.DLL
    file[]: crc = 67fad4ac; size =      5632; name = ARCADEVF.DLL
    file[]: crc = 88c87cda; size =     19712; name = ARCCTL.DLL
    file[]: crc = c22e8c3c; size =     10240; name = ARCFONTS.FON
    file[]: crc = 61de4f3b; size =    165120; name = ASTEROID.EXE
    file[]: crc = ebd12fe8; size =     78853; name = ASTEROID.HLP
    file[]: crc = dc5c782e; size =     24576; name = WAVEMIX.DLL


end


