desc[msft-wep32bit]:

name = Windows Entertainment Pack 32-bit prototypes
icon = msft-wep32bit.png
machine = pc
rootpath = C:\WEP
osenv= windows 98

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)


//
// Windows setting
//
config[winsetting]:
    title = Video Configuration
    option[crop]:   wincrop = true; name = Crop window
    option[full]: name = Full desktop; priority = 1
end


//
//  Cruel
//
game[pc-en-cruel]:
    name = Cruel
    anchorfile = cruel.exe
    launch = "$(rootpath)\cruel.exe
    winres = 640x480x8
    file[]: crc = a2dbe378; size =    157456; name = cards.dll
    file[]: crc = 9c3ca596; size =     27920; name = cruel.exe


end

