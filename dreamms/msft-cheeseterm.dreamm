// v1.0 1992
//
game[pc-en]:
    name = v1.0
    anchorfile = mct.exe
	file[]: crc = 5f7354d9; size =    176128; name = MCT.EXE
    file[]: crc = 8e3332d4; size =      9445; name = MCTHELP.HLP
end

