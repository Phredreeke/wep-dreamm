desc[msft-wepsampler]:

name = Windows Entertainment Pack Verbatim Sampler
icon = msft-wepsampler.png
machine = pc
rootpath = C:\WEP
osenv= windows 3.11.002

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)


//
// installer
//
installer[pc-en-wepsampler1]:
    name = WEP Verbatim Sampler Installer
    anchorfile = WEPSETUP.IN_
    launch = "$(rootpath)\SETUP.EXE"
    installid = *
    file[]: crc = cf73967b; size =     49647; name = _MSTEST.EX_
